# ---- LLM providers (OpenAI-compatible) ----
# Filter config YAML 에서 `params.provider: openai | vllm | glm` 로 스위치.
# caller 가 명시적으로 api_key/base_url 을 넘기지 않고 provider 만 지정하면,
# APIClient 가 아래 pair 를 자동 로드한다.

# OpenAI (GPT-4o-mini 등). base_url 은 SDK 기본값 (https://api.openai.com/v1) 사용.
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Local vLLM / Ollama 서버
VLLM_BASE_URL=<YOUR_LOCAL_LLM_SERVER_URL>
VLLM_API_KEY=<YOUR_LOCAL_LLM_API_KEY>

# Zhipu GLM (OpenAI-compatible). 예: https://open.bigmodel.cn/api/paas/v4
# 모델 ID 는 Zhipu 콘솔에서 확인 (예: glm-4-plus, glm-4.6) 후 filter config 의 model_name 에 기재.
GLM_BASE_URL=<YOUR_GLM_BASE_URL>
GLM_API_KEY=<YOUR_GLM_API_KEY>

# Claude API
CLAUDE_API_KEY=<YOUR_CLAUDE_API_KEY>

# ---- WandB ----
WANDB_DIR=<YOUR_WANDB_DIR>
WANDB_PROJECT=<YOUR_WANDB_PROJECT_NAME>

# ---- Dataset paths (absolute; override per machine) ----
TRAIN_JSON=<YOUR_TRAIN_JSON_DATA>
TRAIN_DB_DIR=<YOUR_TRAIN_DB_DIR>
DEV_JSON=<YOUR_DEV_JSON_DATA>
DEV_DB_DIR=<YOUR_DEV_DB_DIR>
