+def _norm_gold_name(s: str) -> str:
+    """gold 매칭용 단일 정규화 (2차 작업지시서 §1.1).
+
+    parse_sql_elements 출력과 col_to_id/table_to_id 키 **양측에 동일 적용**한다.
+    strip → 양끝 backtick/따옴표 제거 → 연속 공백 1칸 → 소문자.
+    배경: parse_sql_elements 는 소문자/backtick-strip 하지만 col_to_id 키는 원본
+    대소문자('frpm.County Name')라, 기존 case-sensitive `endswith`/`in gold_tables`
+    매칭이 대소문자·공백 컬럼/테이블명 DB 에서 gold 를 대량 누락했다.
+    """
+    s = str(s).strip().strip('`"\'')
+    s = re.sub(r"\s+", " ", s)
+    return s.lower()
