# M4 — LLM API 환경변수 템플릿
# 이 파일을 `.env` 로 복사한 뒤 값을 채우십시오:  cp .env.example .env
#
# BidirectionalFilter 와 LLMSQLGenerator 는 provider="glm" 으로 동작하며,
# OpenAI-compatible endpoint 를 호출합니다 (예: Elice ML API).

# GLM-4.7 endpoint (OpenAI-compatible base URL)
GLM_BASE_URL=https://<your-openai-compatible-endpoint>/v1

# GLM-4.7 API key
GLM_API_KEY=<your-api-key>

# (선택) 토크나이저 병렬 경고 억제 — main.py 가 기본 설정
# TOKENIZERS_PARALLELISM=false
